
{
  "manifest_version": 3,
  "name": "Sumora AI",
  "version": "1.0",
  "description": "AI-powered text summarization for any webpage.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://my-ai-extension-backend.onrender.com/*",
    "https://qjcnhwvrmierkoexurlk.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
